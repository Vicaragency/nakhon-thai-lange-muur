# --- Payload ---
# Genereer met: openssl rand -hex 32
PAYLOAD_SECRET=

# --- Database ---
# Leeg laten voor lokale SQLite (file:./payload-local.db).
# In productie: Neon Postgres connection string (begint met "postgres").
DATABASE_URI=

# --- Public URL ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Externe platforms (reserveren / bestellen) ---
# Leeg laten = de standaardwaarden uit de code worden gebruikt:
#   reserveren -> https://bookings.zenchef.com/results?rid=367627&pid=1001
#   Nakhon Thai bestellen -> https://nakhonthai-brugge.be/online-bestellen/
#   De Lange Muur bestellen -> https://nakhonthai-brugge.be/order-online/
# Verhuist het bestelsysteem (bv. naar bestellen.nakhonthai.be) of komt er een
# ander platform? Zet dan hier de nieuwe URL en deploy opnieuw. Geen code-wijziging.
NEXT_PUBLIC_RESERVE_URL=
NEXT_PUBLIC_ORDER_URL_NAKHON=
NEXT_PUBLIC_ORDER_URL_LANGE_MUUR=

# --- Media-opslag (S3-compatibel, bv. Vercel Blob / Supabase Storage) — later ---
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- E-mail (Resend) — later ---
RESEND_API_KEY=
EMAIL_FROM=info@meirlaen-bvba.be
EMAIL_TO=info@meirlaen-bvba.be
